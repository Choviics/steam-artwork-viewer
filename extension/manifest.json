{
  "manifest_version": 3,
  "name": "Steam Artwork Viewer",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/artwork-16.png",
    "48": "icons/artwork-48.png",
    "128": "icons/artwork-128.png"
  },
  "background": { "service_worker": "steam-handoff.js" },
  "host_permissions": ["https://*.steamusercontent.com/*", "https://steamuserimages-a.akamaihd.net/*"],
  "content_scripts": [{
    "matches": ["https://steamcommunity.com/id/*", "https://steamcommunity.com/profiles/*", "https://steamcommunity.com/my/edit/showcases*", "https://steamcommunity.com/sharedfiles/filedetails*"],
    "js": ["constants.js", "i18n.js", "utils.js", "artwork-gif.js", "artwork-image.js", "artwork-zip.js", "viewer.js", "steam-showcase.js"],
    "css": ["viewer.css"]
  }, {
    "matches": ["https://steamcommunity.com/sharedfiles/edititem/767/3/*"],
    "js": ["constants.js", "i18n.js", "utils.js", "steam-upload-form.js"]
  }, {
    "matches": ["https://steamcommunity.com/id/*/edit/showcases*", "https://steamcommunity.com/profiles/*/edit/showcases*", "https://steamcommunity.com/my/edit/showcases*"],
    "js": ["steam-showcase-picker.js"],
    "world": "MAIN"
  }]
}
